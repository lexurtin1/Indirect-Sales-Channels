    {
      "id": "dist",
      "chip": "Distribution insight",
      "keywords": ["distributor", "outflow", "inflow", "platform", "redemption", "distribution", "sales"],
      "prompt": "Which distributors drove net outflows in {{fundShort}} last month?",
      "tools": [
        { "name": "orders.flows", "args": { "isin": "{{isin}}", "group_by": "distributor", "period": "2026-09" }, "status": "41 distributors", "kind": "mcp", "latency": 880, "rows": 41 },
        { "name": "crm.accounts", "args": { "ids": "top_outflows" }, "status": "5 accounts", "kind": "int", "latency": 360, "rows": 5 },
        { "name": "sales.coverage_owner", "args": {}, "status": "5 owners", "kind": "int", "latency": 240, "rows": 5 }
      ],
      "blocks": [
        { "type": "p", "s": "Net outflow of **$38m** from {{fundShort}} last month. **84%** of that outflow came from the three distributors listed below." },
        {
          "type": "table",
          "head": ["Distributor", "Net flow", "vs 3m avg", "Owner"],
          "grid": "1.4fr 1fr 1fr 1fr",
          "rows": [
            ["{{dist2}}", "−$18.4m", "−310%", "A. Quinn"],
            ["{{dist0}}", "−$8.9m", "−120%", "M. Costa"],
            ["{{dist3}}", "−$4.7m", "−60%", "A. Quinn"],
            ["{{dist1}}", "+$6.1m", "+40%", "L. Ng"]
          ]
        },
        { "type": "p", "s": "Your CRM shows that {{dist2}} completed a **model portfolio rebalance** on 12 September, which explains their outflow." }
